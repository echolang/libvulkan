/**
 * Emitters and the two naming functions.
 *
 * A line is interpolated, then appended. Interpolation-in-a-loop against the
 * accumulating buffer is the documented O(n²) trap; `reserve` plus append of
 * a finished line is the way out.
 */

namespace vkgen::emit;

use vkgen::reg;
use vkgen::feat;
use vkgen::types;
use vkgen::Error;

internal const uint64 U32_MAX = 0xFFFFFFFF;

public struct Banner
{
    public string $invocation;
    public string $api;
    public string $version;
    public array<string> $extensions;
    public string $registrySha;

    public constructor()
    {
        $this->invocation = '';
        $this->api = '';
        $this->version = '';
        $this->extensions = array<string>();
        $this->registrySha = '';
    }
}

public struct Emitted
{
    public string $source;
    public usize $nEnums;
    public usize $nCommands;
    public usize $nHandles;
    public usize $nStructs;
    public usize $nStubs;

    public constructor()
    {
        $this->source = '';
        $this->nEnums = 0;
        $this->nCommands = 0;
        $this->nHandles = 0;
        $this->nStructs = 0;
        $this->nStubs = 0;
    }
}

private struct Stub
{
    public string $ret;
    public array<string> $params;

    public constructor()
    {
        $this->ret = 'void';
        $this->params = array<string>();
    }
}

public function emitModule(
    const feat::Folded& $folded,
    const Banner& $banner,
    const reg::Registry& $reg
) : result<Emitted, Error>
{
    $constFrom = ordered_map<string, string>();
    $echoConsts = array<string>();
    $echoFns = array<string>();

    usize $i = 0;

    while ($i < $folded->enums->count()) {
        $vk = $folded->enums[$i]->name;
        $echo = guard feat::stripConst($vk) else ($e) {
            return .error($e);
        }

        if ($constFrom->has($echo)) {
            return .error(.nameCollision('enum', $echo, $constFrom->get($echo), $vk));
        }

        $constFrom[$echo] = $vk;
        $echoConsts[] = $echo;
        $i = $i + 1;
    }

    $fnFrom = ordered_map<string, string>();
    $i = 0;

    while ($i < $folded->commands->count()) {
        $vk = $folded->commands[$i]->name;
        $echo = guard feat::stripFn($vk) else ($e) {
            return .error($e);
        }

        if ($fnFrom->has($echo)) {
            return .error(.nameCollision('command', $echo, $fnFrom->get($echo), $vk));
        }

        $fnFrom[$echo] = $vk;
        $echoFns[] = $echo;
        $i = $i + 1;
    }

    $stubOf = ordered_map<string, usize>();
    $stubs = array<Stub>();
    $i = 0;

    while ($i < $folded->commands->count()) {
        $sig = externSig($folded->commands[$i]);

        if (!$stubOf->has($sig)) {
            $s = Stub();
            $s->ret = $folded->commands[$i]->retExtern;
            usize $p = 0;

            while ($p < $folded->commands[$i]->params->count()) {
                $s->params[] = $folded->commands[$i]->params[$p]->externType;
                $p = $p + 1;
            }

            $stubOf[$sig] = $stubs->count();
            $stubs[] = $s;
        }

        $i = $i + 1;
    }

    $out = Emitted();
    $out->nEnums = $folded->enums->count();
    $out->nCommands = $folded->commands->count();
    $out->nHandles = $folded->handles->count();
    $out->nStructs = $folded->structs->count();
    $out->nStubs = $stubs->count();
    $out->source->reserve(8388608);

    banner($out->source, $banner);
    $out->source->append("namespace vk;\n\n");

    $consts = constants($out->source, $folded, $echoConsts);

    if ($consts->failed()) {
        return .error($consts->failure());
    }

    $res = resultEnum($out->source, $folded);

    if ($res->failed()) {
        return .error($res->failure());
    }

    $h = handles($out->source, $folded);

    if ($h->failed()) {
        return .error($h->failure());
    }

    $st = structs($out->source, $folded, $reg);

    if ($st->failed()) {
        return .error($st->failure());
    }

    stubs($out->source, $stubs);
    table($out->source, $folded, $echoFns, $stubOf);
    state($out->source);
    loadFns($out->source, $folded, $echoFns);
    wrappers($out->source, $folded, $echoFns);

    return .ok($out);
}

private function banner(string& $out, const Banner& $b) : void
{
    $out->append("// Generated by libvulkan generate. Do not edit.\n");
    $line = "// {$b->invocation}\n";
    $out->append($line);
    $line = "// api={$b->api} version={$b->version}\n";
    $out->append($line);

    $exts = '';
    usize $i = 0;

    while ($i < $b->extensions->count()) {
        if ($i > 0) {
            $exts->append(', ');
        }

        $exts->append($b->extensions[$i]);
        $i = $i + 1;
    }

    if ($exts->empty()) {
        $exts = '(none)';
    }

    $line = "// extensions: {$exts}\n";
    $out->append($line);
    $line = "// registry: {$b->registrySha}\n\n";
    $out->append($line);
}

private function constants(string& $out, const feat::Folded& $folded, const array<string>& $echo) : result<bool, Error>
{
    usize $i = 0;

    while ($i < $folded->enums->count()) {
        $e = $folded->enums[$i];
        $name = $echo[$i];

        if ($e->kind == reg::EnumKind::alias && !$e->resolved) {
            return .error(.unresolvedAlias($e->name, $e->alias));
        }

        if ($e->kind == reg::EnumKind::str) {
            $line = "public const string {$name} = '{$e->text}';\n";
            $out->append($line);
            $i = $i + 1;
            continue;
        }

        if ($e->kind == reg::EnumKind::f32) {
            string $lit = $e->text;

            if ($lit->ends('F') || $lit->ends('f')) {
                $lit = $lit->sub(0, $lit->size() - 1);
            }

            $line = "public const float32 {$name} = {$lit};\n";
            $out->append($line);
            $i = $i + 1;
            continue;
        }

        if ($e->kind == reg::EnumKind::i32) {
            int64 $sv = signed32($e->value);
            $line = "public const int32 {$name} = {$sv};\n";
            $out->append($line);
            $i = $i + 1;
            continue;
        }

        $ty = 'uint32';

        if ($e->kind == reg::EnumKind::u64 || $e->value > U32_MAX) {
            $ty = 'uint64';
        }

        $hex = hexLit($e->value);
        $line = "public const {$ty} {$name} = {$hex};\n";
        $out->append($line);
        $i = $i + 1;
    }

    $out->append('\n');

    return .ok(true);
}

private function resultEnum(string& $out, const feat::Folded& $folded) : result<bool, Error>
{
    $seenVal = map<uint64, bool>();
    $seenName = map<string, string>();
    $lines = array<string>();
    usize $i = 0;

    while ($i < $folded->enums->count()) {
        $e = $folded->enums[$i];

        string $group = $e->group;
        string $extends = $e->extends;
        bool $vkResult = $group == 'VkResult' || $extends == 'VkResult';

        if (!$vkResult || !$e->resolved || $e->kind == reg::EnumKind::alias) {
            $i = $i + 1;
            continue;
        }

        if ($seenVal->has($e->value)) {
            $i = $i + 1;
            continue;
        }

        $case = guard feat::enumCase($e->name) else ($err) {
            return .error($err);
        }

        if ($case == 'other') {
            return .error(.nameCollision('enum case', $case, $e->name, 'other'));
        }

        if ($seenName->has($case)) {
            return .error(.nameCollision('enum case', $case, $seenName->get($case), $e->name));
        }

        $seenVal[$e->value] = true;
        $seenName[$case] = $e->name;
        int64 $sv = signed32($e->value);
        $lines[] = "    case {$case} = {$sv};\n";
        $i = $i + 1;
    }

    if ($lines->empty()) {
        return .error(.context('Result', 'no VkResult values in the fold'));
    }

    $out->append("public enum Result : int32\n");
    $out->append("{\n");
    usize $n = 0;

    while ($n < $lines->count()) {
        $out->append($lines[$n]);
        $n = $n + 1;
    }

    $out->append("    case other;\n\n");
    $out->append("    public const function ok() : bool\n");
    $out->append("    {\n");
    $out->append("        return $this->value() >= 0;\n");
    $out->append("    }\n");
    $out->append("}\n\n");
    $out->append("public function check(Result $r) : result<Result, Error>\n");
    $out->append("{\n");
    $out->append("    if ($r->value() >= 0) {\n");
    $out->append("        return .ok($r);\n");
    $out->append("    }\n\n");
    $out->append("    return .error(.vulkan($r->value()));\n");
    $out->append("}\n\n");

    return .ok(true);
}

private function signed32(uint64 $v) : int64
{
    if ($v <= 0x7FFFFFFF) {
        return $v as int64;
    }

    if ($v >= 0x100000000) {
        return $v as int64;
    }

    uint64 $mag = 0x100000000 - $v;

    return 0 - ($mag as int64);
}

private function handles(string& $out, const feat::Folded& $folded) : result<bool, Error>
{
    usize $i = 0;

    while ($i < $folded->handles->count()) {
        $echo = guard feat::stripType($folded->handles[$i]->name) else ($e) {
            return .error($e);
        }

        $out->append("public struct {$echo}\n");
        $out->append("{\n");
        $out->append("    public uint64 $handle;\n\n");
        $out->append("    public static function none() : {$echo}\n");
        $out->append("    {\n");
        $out->append("        return {$echo}(0);\n");
        $out->append("    }\n");
        $out->append("}\n\n");
        $i = $i + 1;
    }

    return .ok(true);
}

private function structs(
    string& $out,
    const feat::Folded& $folded,
    const reg::Registry& $reg
) : result<bool, Error>
{
    usize $i = 0;

    while ($i < $folded->structs->count()) {
        $td = $folded->structs[$i];
        $echo = guard feat::stripType($td->name) else ($e) {
            return .error($e);
        }

        $out->append("public struct {$echo}\n");
        $out->append("{\n");

        $seenField = map<string, bool>();
        $assigns = array<string>();
        array<reg::Member> $members = $td->members;

        if ($td->kind == reg::TypeKind::union && $members->count() > 1) {
            array<reg::Member> $unionMems = guard unionMembersToEmit($folded, $reg, $td) else ($e) {
                return .error($e);
            }

            $members = $unionMems;
        }

        usize $m = 0;

        while ($m < $members->count()) {
            $mem = $members[$m];
            int32 $arrayN = guard memberArrayN($folded, $reg, $mem->decl, $td->name) else ($e) {
                return .error($e);
            }
            $ty = guard feat::mapFieldElem($reg, $folded, $mem->decl, $td->name) else ($e) {
                return .error($e);
            }

            $fname = feat::paramName($mem->decl->name, $m);

            if ($seenField->has($fname)) {
                $m = $m + 1;
                continue;
            }

            $seenField[$fname] = true;

            if ($arrayN > 0) {
                $fieldTy = "{$ty}[{$arrayN}]";
                $line = "    public {$fieldTy} ${$fname};\n";
                $out->append($line);
                pushAssign($assigns, $folded, $fname, $fieldTy, '');
            } else {
                $def = guard fieldDefault($mem, $ty) else ($e) {
                    return .error($e);
                }
                $line = "    public {$ty} ${$fname}{$def};\n";
                $out->append($line);
                pushAssign($assigns, $folded, $fname, $ty, $def);
            }

            $m = $m + 1;
        }

        if ($assigns->count() > 0) {
            $out->append('\n');
            $out->append("    public constructor()\n");
            $out->append("    {\n");
            usize $p = 0;

            while ($p < $assigns->count()) {
                $out->append($assigns[$p]);
                $p = $p + 1;
            }

            $out->append("    }\n");
        }

        $out->append("}\n\n");
        $i = $i + 1;
    }

    return .ok(true);
}

private function pushAssign(
    array<string>& $assigns,
    const feat::Folded& $folded,
    const string& $fname,
    const string& $ty,
    const string& $def
) : void
{
    if (!$def->empty()) {
        return;
    }

    usize $bracket = $ty->find('[');

    if ($bracket < $ty->size()) {
        $assigns[] = "        {$ty} $z_{$fname};\n";
        $assigns[] = "        $this->{$fname} = mv $z_{$fname};\n";
        return;
    }

    if ($ty->starts('ptr<')) {
        $assigns[] = "        $this->{$fname}:$ = null;\n";
        return;
    }

    if (isHandleEcho($folded, $ty)) {
        $assigns[] = "        $this->{$fname} = {$ty}(0);\n";
        return;
    }

    $assigns[] = "        $this->{$fname} = {$ty}();\n";
}

private function isHandleEcho(const feat::Folded& $folded, const string& $echo) : bool
{
    return $folded->handleEcho->has($echo);
}

private function fieldDefault(
    const reg::Member& $mem,
    const string& $ty
) : result<string, Error>
{
    if (!$mem->values->empty()) {
        string $vk = $mem->values;
        usize $comma = $vk->find(',');

        if ($comma < $vk->size()) {
            $vk = $vk->sub(0, $comma);
        }

        string $echoName = guard feat::stripConst($vk) else ($e) {
            return .error($e);
        }

        return .ok(" = {$echoName}");
    }

    if ($ty->starts('ptr<')) {
        return .ok('');
    }

    if ($ty == 'uint32' || $ty == 'int32' || $ty == 'uint64' || $ty == 'int64' || $ty == 'uint8' || $ty == 'int8' || $ty == 'uint16' || $ty == 'int16' || $ty == 'usize') {
        return .ok(' = 0');
    }

    if ($ty == 'float32') {
        return .ok(' = 0.0f');
    }

    if ($ty == 'float64') {
        return .ok(' = 0.0');
    }

    return .ok('');
}

private function stubs(string& $out, const array<Stub>& $stubs) : void
{
    usize $i = 0;

    while ($i < $stubs->count()) {
        $s = $stubs[$i];
        $args = stubArgs($s);
        $line = "private function __missing_{$i}({$args}) : {$s->ret}\n";
        $out->append($line);
        $out->append("{\n");
        $out->append("    die('vk: entry point called before vk::load, or unavailable in this ICD');\n");
        $out->append("}\n\n");
        $i = $i + 1;
    }
}

private function stubArgs(const Stub& $s) : string
{
    $args = '';
    usize $i = 0;

    while ($i < $s->params->count()) {
        if ($i > 0) {
            $args->append(', ');
        }

        $args->append($s->params[$i]);
        $args->append(" $a{$i}");
        $i = $i + 1;
    }

    return $args;
}

private function table(
    string& $out,
    const feat::Folded& $folded,
    const array<string>& $echo,
    const ordered_map<string, usize>& $stubOf
) : void
{
    $out->append("public struct commands\n{\n");
    usize $i = 0;

    while ($i < $folded->commands->count()) {
        $sig = externSig($folded->commands[$i]);
        $ty = "extern function<{$sig}>";
        $line = "    public {$ty} ${$echo[$i]};\n";
        $out->append($line);
        $i = $i + 1;
    }

    $out->append('\n');
    $out->append("    public constructor()\n");
    $out->append("    {\n");
    $i = 0;

    while ($i < $folded->commands->count()) {
        $sig = externSig($folded->commands[$i]);
        usize $stub = $stubOf->get($sig);
        $line = "        $this->{$echo[$i]} = &__missing_{$stub};\n";
        $out->append($line);
        $i = $i + 1;
    }

    $out->append("    }\n");
    $out->append("}\n\n");
}

private function state(string& $out) : void
{
    $out->append("public struct state\n");
    $out->append("{\n");
    $out->append("    public static commands $commands = commands();\n");
    $out->append("}\n\n");
}

private function loadFns(string& $out, const feat::Folded& $folded, const array<string>& $echo) : void
{
    emitLoad($out, $folded, $echo, 'load', reg::CmdLevel::global, 'extern function<ptr<uint8>(ptr<const uint8>)> $getproc');
    emitLoad($out, $folded, $echo, 'loadInstance', reg::CmdLevel::instance, 'Instance $instance');
    emitLoad($out, $folded, $echo, 'loadDevice', reg::CmdLevel::device, 'Device $device');

    $out->append("public function loadDefault() : usize\n");
    $out->append("{\n");
    $out->append("    if (!bindLoader()) {\n");
    $out->append("        return 0;\n");
    $out->append("    }\n\n");
    $out->append("    return load(&trampoline);\n");
    $out->append("}\n\n");
}

private function emitLoad(
    string& $out,
    const feat::Folded& $folded,
    const array<string>& $echo,
    const string& $name,
    reg::CmdLevel $level,
    const string& $params
) : void
{
    $out->append("public function {$name}({$params}) : usize\n");
    $out->append("{\n");
    $out->append("    usize $n = 0;\n");
    $out->append("    ptr<uint8> $p = null;\n");
    $out->append("    string $nm = '';\n");

    if ($level == reg::CmdLevel::instance) {
        $out->append("    extern function<ptr<uint8>(uint64, ptr<const uint8>)> $get = state::$commands->GetInstanceProcAddr;\n");
    }

    if ($level == reg::CmdLevel::device) {
        $out->append("    extern function<ptr<uint8>(uint64, ptr<const uint8>)> $get = state::$commands->GetDeviceProcAddr;\n");
    }

    $out->append('\n');

    usize $i = 0;

    while ($i < $folded->commands->count()) {
        $c = $folded->commands[$i];

        if ($c->level != $level) {
            $i = $i + 1;
            continue;
        }

        $sig = externSig($c);
        $ty = "extern function<{$sig}>";
        $field = $echo[$i];
        $line = "    $nm = '{$c->name}';\n";
        $out->append($line);

        if ($level == reg::CmdLevel::global) {
            $out->append("    $p:$ = $getproc($nm->cstr());\n");
        } else if ($level == reg::CmdLevel::instance) {
            $out->append("    $p:$ = $get($instance->handle, $nm->cstr());\n");
        } else {
            $out->append("    $p:$ = $get($device->handle, $nm->cstr());\n");
        }

        $out->append("    if ($p:$ != null) {\n");
        $line = "        unsafe { state::$commands->{$field} = $p:$ as {$ty}; }\n";
        $out->append($line);
        $out->append("        $n = $n + 1;\n");
        $out->append("    }\n\n");
        $i = $i + 1;
    }

    $out->append("    return $n;\n");
    $out->append("}\n\n");
}

private function wrappers(string& $out, const feat::Folded& $folded, const array<string>& $echo) : void
{
    usize $i = 0;

    while ($i < $folded->commands->count()) {
        $c = $folded->commands[$i];
        $args = '';
        $call = '';
        usize $p = 0;
        $used = map<string, bool>();

        while ($p < $c->params->count()) {
            $raw = feat::paramName($c->params[$p]->cName, $p);

            if ($used->has($raw)) {
                $raw = "p{$p}";
            }

            $used[$raw] = true;

            if ($p > 0) {
                $args->append(', ');
                $call->append(', ');
            }

            $args->append($c->params[$p]->echoType);
            $args->append(" ${$raw}");

            if ($c->params[$p]->handleByValue) {
                $call->append("${$raw}->handle");
            } else if ($c->params[$p]->echoType == 'Result') {
                $call->append("${$raw}->value()");
            } else {
                $call->append("${$raw}");
            }

            $p = $p + 1;
        }

        $name = $echo[$i];
        $line = "#[inline]\npublic function {$name}({$args}) : {$c->retEcho}\n";
        $out->append($line);
        $out->append("{\n");
        $line = "    state::$commands->{$name}({$call});\n";

        if ($c->retEcho == 'Result') {
            $line = "    return Result::from(state::$commands->{$name}({$call}));\n";
        } else if ($c->retEcho != 'void') {
            $line = "    return state::$commands->{$name}({$call});\n";
        }

        $out->append($line);
        $out->append("}\n\n");
        $i = $i + 1;
    }
}

private function externSig(const reg::Command& $c) : string
{
    string $s = $c->retExtern;
    $s->append('(');
    usize $i = 0;

    while ($i < $c->params->count()) {
        if ($i > 0) {
            $s->append(', ');
        }

        $s->append($c->params[$i]->externType);
        $i = $i + 1;
    }

    $s->append(')');

    return $s;
}

private function hexLit(uint64 $v) : string
{
    return "0x{$v:X}";
}
