public struct ClearValue
{
    public ClearColorValue $color;

    public constructor()
    {
        $this->color = ClearColorValue();
    }

    public constructor(depth: float32 $depth, stencil: uint32 $stencil)
    {
        $this->color = ClearColorValue();
        ClearDepthStencilValue $arm = ClearDepthStencilValue();
        $arm->depth = $depth;
        $arm->stencil = $stencil;
        mem::copy<uint8>(ptr<uint8>(&$this->color), ptr<uint8>(&$arm), 8);
    }
}

