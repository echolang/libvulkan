public struct ClearColorValue
{
    public float32[4] $float32;

    public constructor()
    {
        float32[4] $z_float32;
        $this->float32 = mv $z_float32;
    }

    public constructor(int32: int32[4] $int32)
    {
        float32[4] $z_float32;
        $this->float32 = mv $z_float32;
        int32[4] $arm = $int32;
        mem::copy<uint8>(ptr<uint8>(&$this->float32), ptr<uint8>(&$arm), 16);
    }

    public constructor(uint32: uint32[4] $uint32)
    {
        float32[4] $z_float32;
        $this->float32 = mv $z_float32;
        uint32[4] $arm = $uint32;
        mem::copy<uint8>(ptr<uint8>(&$this->float32), ptr<uint8>(&$arm), 16);
    }
}

