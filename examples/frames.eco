function parseFrames(const array<string>& $argv) : result<int32, string>
{
    int32 $frames = 300;
    usize $i = 1;

    while ($i < $argv->count()) {
        string $a = $argv[$i];

        if ($a == '--frames') {
            if ($i + 1 >= $argv->count()) {
                return .error('--frames needs a value');
            }

            int64 $n = guard str::int($argv[$i + 1]) else {
                return .error('--frames needs an integer');
            }

            return .ok($n as int32);
        }

        return .error("unknown flag '{$a}'");
    }

    return .ok($frames);
}
